rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "mxqMPdrbN2Nmmqe6YWU3GYJM5GB3";
    }

    function isApprovedDSA() {
      return signedIn()
        && exists(/databases/$(database)/documents/dsas/$(request.auth.uid))
        && get(/databases/$(database)/documents/dsas/$(request.auth.uid)).data.status == "approved";
    }

    function isApprovedAgent() {
      return signedIn()
        && exists(/databases/$(database)/documents/agents/$(request.auth.uid))
        && get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.status == "approved";
    }

    function isMyDSAAgent(agentUid) {
      return isApprovedDSA()
        && exists(/databases/$(database)/documents/agents/$(agentUid))
        && get(/databases/$(database)/documents/agents/$(agentUid)).data.dsaUid == request.auth.uid;
    }

    // Photo-only update validation
    function isPhotoOnlyUpdate() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(["photoData", "photoUpdatedAt"])
        && request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(["photoData"])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 350000
        && request.resource.data.photoUpdatedAt is timestamp;
    }

    // Customer inquiries
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().size() > 0
        && request.resource.data.keys().size() <= 25
        && (!('customerConsent' in request.resource.data.keys())
            || request.resource.data.customerConsent == true);

      allow read, update, delete: if isAdmin();
    }

    // DSA profiles
    match /dsas/{dsaUid} {
      allow create: if signedIn()
        && request.auth.uid == dsaUid
        && request.resource.data.uid == dsaUid
        && request.resource.data.status == "pending"
        && request.resource.data.memberType == "dsa";

      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == dsaUid);

      allow list: if isAdmin();

      allow update: if isAdmin()
        || (isApprovedDSA()
            && request.auth.uid == dsaUid
            && isPhotoOnlyUpdate());

      allow delete: if isAdmin();
    }

    // Agent profiles
    match /agents/{agentId} {
      allow create: if signedIn()
        && request.resource.data.uid == agentId
        && request.resource.data.status == "pending"
        && request.resource.data.memberType == "referral_agent"
        && request.resource.data.keys().hasAll([
          "uid", "name", "fatherName", "address", "city",
          "district", "pin", "mobile", "whatsapp", "email",
          "status", "memberType", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "name", "fatherName", "address", "city",
          "district", "pin", "mobile", "whatsapp", "email",
          "status", "memberType", "createdAt",
          "dsaUid", "dsaId", "agentId", "agentCode"
        ])
        && (
          request.auth.uid == agentId
          ||
          (isApprovedDSA()
            && request.resource.data.dsaUid == request.auth.uid
            && request.resource.data.dsaId
              == get(/databases/$(database)/documents/dsas/$(request.auth.uid)).data.dsaId)
        );

      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == agentId)
        || (isApprovedDSA()
            && resource.data.dsaUid == request.auth.uid);

      allow list: if isAdmin()
        || (isApprovedDSA()
            && resource.data.dsaUid == request.auth.uid);

      allow update: if isAdmin()
        || (
          (
            (isApprovedAgent() && request.auth.uid == agentId)
            || isMyDSAAgent(agentId)
          )
          && isPhotoOnlyUpdate()
        );

      allow delete: if isAdmin();
    }

    // Customer leads
    match /leads/{leadId} {
      allow create: if isApprovedAgent()
        && request.resource.data.agentUid == request.auth.uid
        && request.resource.data.customerConsent == true
        && request.resource.data.status == "New"
        && request.resource.data.keys().hasAll([
          "agentUid", "agentName", "agentMobile",
          "customerName", "mobile", "address",
          "district", "pin", "loanType", "loanAmount",
          "customerConsent", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "agentUid", "agentName", "agentMobile",
          "customerName", "mobile", "address",
          "district", "pin", "loanType", "loanAmount",
          "customerConsent", "status", "createdAt"
        ])
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[0-9]{10}$')
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{6}$');

      allow read: if isAdmin()
        || (isApprovedAgent()
            && resource.data.agentUid == request.auth.uid)
        || isMyDSAAgent(resource.data.agentUid);

      allow update, delete: if isAdmin();
    }

    // Commission records
    match /commissions/{id} {
      allow read: if isAdmin()
        || (isApprovedAgent()
            && resource.data.agentUid == request.auth.uid)
        || isMyDSAAgent(resource.data.agentUid);

      allow create, update, delete: if isAdmin();
    }

    // Partner links
    match /partnerLinks/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Counters
    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    // All other collections blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}